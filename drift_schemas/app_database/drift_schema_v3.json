  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"priority\" INTEGER NOT NULL DEFAULT 1, \"due_at\" TEXT NULL, \"category\" TEXT NULL, \"tags\" TEXT NOT NULL DEFAULT '[]', \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"version\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" TEXT NOT NULL, \"dirty\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dirty\" IN (0, 1)), \"server_snapshot\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_queue",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_queue\" (\"seq\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"op_id\" TEXT NOT NULL UNIQUE, \"task_id\" TEXT NOT NULL REFERENCES tasks (id), \"op_type\" TEXT NOT NULL, \"payload_json\" TEXT NOT NULL, \"base_version\" INTEGER NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_retry_at\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"last_error\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "sync_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_log\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"at\" TEXT NOT NULL, \"level\" TEXT NOT NULL, \"message\" TEXT NOT NULL, \"task_id\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "sync_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_state\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "idx_queue_task",
